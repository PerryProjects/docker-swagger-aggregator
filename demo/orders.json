{
  "openapi": "3.0.3",
  "info": { "title": "Orders (demo)", "version": "1.0.0", "description": "OpenAPI 3 demo service WITH a Docker HEALTHCHECK." },
  "servers": [{ "url": "http://orders:8000" }],
  "paths": {
