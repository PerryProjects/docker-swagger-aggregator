# Copy to build-in-admin.env (git ignores it) and change the password: at least 10 characters.
SWAGGER_AGGREGATOR_WEB_ADMIN_USER=admin
SWAGGER_AGGREGATOR_WEB_ADMIN_PASSWORD=change-me-please
# Instead of a plaintext password you can give a bcrypt hash (use ADMIN_PASSWORD_HASH and drop ADMIN_PASSWORD
# from the overlay):  docker run --rm httpd:2.4-alpine htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n'
